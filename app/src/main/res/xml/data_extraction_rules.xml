<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer rules for Android 12 and higher.
   A full backup is intentional: with no include or exclude rules, all app
   data, including the vehicle-maintenance.json store, goes to the user's own
   Google account backup and moves in a device-to-device transfer. The privacy
   policy and the Data safety answers in play-store/ describe this; keep them
   in step if this changes.
-->
<data-extraction-rules>
    <cloud-backup />
</data-extraction-rules>
